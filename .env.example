# Copy to `.env` and fill in the MLflow run ids of your trained runs.
# These are resolved in src/config.py and used by src/modeling/predict.py (via
# utils.get_model_run_id). They are machine-/experiment-specific: obtain each id from the
# MLflow run produced by `poetry run python -m src.modeling.train ...`. The corresponding weights must
# exist under `models/<run_id>/` (the `models/` and `mlruns/` directories are not committed).

# MIM (masked image modeling) pretraining on the dental (real) data, by reconstruction loss
RUN_ID_MIM_REAL_L1=
RUN_ID_MIM_REAL_MSE=
RUN_ID_MIM_REAL_SMOOTH_L1=
RUN_ID_MIM_REAL_HUBER=
RUN_ID_MIM_REAL_TUKEY=
RUN_ID_MIM_REAL_SMOOTH_L1_FILTERED=

# Classification / multi-task on the dental (real) data
RUN_ID_CLASS_REAL_MSE=
RUN_ID_REAL_MULTITASK=

# Ultrasound
RUN_ID_MIM_ULTRASOUND_MSE=
RUN_ID_CLASS_ULTRASOUND=
RUN_ID_ULTRASOUND_MULTITASK=

# BRATS
RUN_ID_BRATS_MIM_MSE=

# Optional: force a specific compute device (cpu / cuda / mps). If unset, auto-detected.
# DEVICE=
